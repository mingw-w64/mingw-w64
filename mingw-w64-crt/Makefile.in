libsrc/$(am__dirstamp):
	@$(MKDIR_P) libsrc
	@: > libsrc/$(am__dirstamp)
libsrc/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) libsrc/$(DEPDIR)
	@: > libsrc/$(DEPDIR)/$(am__dirstamp)
libsrc/lib32_libadsiid_a-activeds-uuid.$(OBJEXT):  \
	libsrc/$(am__dirstamp) libsrc/$(DEPDIR)/$(am__dirstamp)
lib32/$(am__dirstamp):
	@$(MKDIR_P) lib32
	@: > lib32/$(am__dirstamp)

lib32/libadsiid.a: $(lib32_libadsiid_a_OBJECTS) $(lib32_libadsiid_a_DEPENDENCIES) $(EXTRA_lib32_libadsiid_a_DEPENDENCIES) lib32/$(am__dirstamp)
	$(AM_V_at)-rm -f lib32/libadsiid.a
	$(AM_V_AR)$(lib32_libadsiid_a_AR) lib32/libadsiid.a $(lib32_libadsiid_a_OBJECTS) $(lib32_libadsiid_a_LIBADD)
	$(AM_V_at)$(RANLIB) lib32/libadsiid.a
