install-crt32DATA: $(crt32_DATA)
	@$(NORMAL_INSTALL)
	@list='$(crt32_DATA)'; test -n "$(crt32dir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(crt32dir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(crt32dir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(crt32dir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(crt32dir)" || exit $$?; \
	done

uninstall-crt32DATA:
	@$(NORMAL_UNINSTALL)
	@list='$(crt32_DATA)'; test -n "$(crt32dir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(crt32dir)'; $(am__uninstall_files_from_dir)
